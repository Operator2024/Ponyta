{
  ".env": {
    "_filepath_": "./",
    "prometheus": {
      "PROM_PORT": "9090",
      "PROM_URL": ""
    },
    "grafana": {
      "PROM_PORT": "9090",
      "DOMAIN": "",
      "GF_PORT": "80",
      "GF_USER": "admin",
      "GF_SECRET": "defaultpassword",
      "GF_SUB_PATH": "/grafana",
      "SMTP_HOST": "",
      "SMTP_USER": "",
      "SMTP_PASSWORD": "",
      "SMTP_FROM_ADDRESS": "",
      "GF_SERVER_CERT_FILE": "/etc/grafana/certs/tls.crt",
      "GF_SERVER_CERT_KEY":"/etc/grafana/certs/tls.key",
      "GF_SERVER_PROTOCOL":"http"
    }
  },
  "web.yml": {
    "_filepath_": "./prometheus",
    "basic_auth_users": {
      "admin": "$2y$12$TEqV7JcONj2KMwSMczSm0OB1FdSwI/aqhfNWv8n9QbU0SAD6TqEV2"
    }
  },
  "secret.txt": {
    "_filepath_": "./prometheus",
    "username": "admin",
    "secret": "defaultpassword"
  },
  "snmp_targets.json": {
    "_filepath_": "./prometheus",
    "data": [
      {
        "labels": {
          "status": "production",
          "type": "external"
        },
        "targets": []
      }
    ]
  },
  "ping.yml": {
    "_filepath_": "./ping_exporter/",
    "targets": [
      "8.8.8.8",
      "8.8.4.4",
      "google.com",
      "vk.com",
      "selectel.ru"
    ],
    "dns": {
      "nameserver": "9.9.9.9",
      "refresh": "30s"
    },
    "ping": {
      "interval": "2s",
      "timeout": "5s",
      "history-size": 42,
      "payload-size": 120
    },
    "options": {
      "disableIPv6": true
    }
  },
  "ping_exporter.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "_file_sd_configs_": false
  },
  "prometheus.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "scrape_interval": "5s",
    "server_name": "",
    "scheme": "http",
    "basic_auth": {
      "username": "admin",
      "password_file": "/etc/prometheus/secret.txt"
    }
  },
  "node_exporter.yml": {
    "_filepath_": "./prometheus/conf.d/"
  },
  "snmp_exporter.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "_file_sd_configs_": true
  },
  "snmp_extended.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "scrape_interval": "60s"
  },
  "snmp_interface.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "scrape_interval": "20s"
  },
  "blackbox_exporter.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "_file_sd_configs_": true
  },
  "blackbox.yml": {
    "_filepath_": "./prometheus/conf.d/"
  },
  "blackbox_targets.json": {
    "_filepath_": "./prometheus",
    "data": [
      {
        "labels": {
          "job": "blackbox",
          "status": "production",
          "type": "external"
        },
        "targets": [
          "http://prometheus.io",
          "https://prometheus.io"
        ]
      }
    ]
  },
  "grafana.yml": {
    "_filepath_": "./prometheus/conf.d/",
    "server_name": "",
    "scheme": "http",
    "basic_auth": {
      "username": "admin",
      "password_file": "/etc/prometheus/secret.txt"
    }
  },
  "datasource.yml": {
    "_filepath_": "./grafana/",
    "scheme": "http"
  }
}