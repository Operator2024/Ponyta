scrape_configs:
  - job_name: 'grafana'
    {% if scheme == 'https' and server_name %}
    scheme: {{ scheme }}
    tls_config:
      cert_file: /etc/prometheus/certs/tls.crt
      key_file: /etc/prometheus/certs/tls.key
      insecure_skip_verify: false
      server_name: {{ server_name }}
    {% else %}
    scheme: http
    {% endif %}
    scrape_timeout: 5s
    {% if basic_auth %}
    basic_auth:
      username: {{ basic_auth.username }}
      {% if basic_auth.password_file %}
      password_file: {{ basic_auth.password_file }}
      {% else %}
      password: {{ basic_auth.password }}
      {% endif %}
    {% endif %}

    {% if static_configs %}
    static_configs:
      - targets:
        {% for target in static_configs.targets  %}
          - {{ target }}
        {% endfor %}
        labels:
        {% for label in static_configs.labels  %}
          {{ label }}: {{ static_configs.labels[label] }}
        {% endfor %}
    {% endif %}{{'\n'}}