scrape_configs:
  - job_name: 'blackbox_exporter'
    metrics_path: /probe
    params:
      module: [http_2xx]  # Look for a HTTP 200 response.
    {% if file_sd_configs %}
    file_sd_configs:
      - files:
        {% for file in file_sd_configs.files  %}
          - {{ file }}
        {% endfor %}
        refresh_interval: {{ file_sd_configs.refresh_interval }}
    {% endif %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 172.18.0.5:9115  # The blackbox exporter's real hostname:port.{{'\n'}}